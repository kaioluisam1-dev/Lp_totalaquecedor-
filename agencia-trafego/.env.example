# ── META ADS ────────────────────────────────────────────────────────────────
# Obtenha em: https://developers.facebook.com/apps/
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
# Token de longa duração (60 dias) — renove via Meta Graph API Explorer
META_ACCESS_TOKEN=seu_token_de_acesso_longa_duracao

# ── GOOGLE ADS ──────────────────────────────────────────────────────────────
# Developer token: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token
# OAuth2 credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_ADS_CLIENT_ID=seu_client_id_oauth
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token
# ID do MCC (conta gerenciadora) sem traços: ex: 1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=seu_mcc_id_sem_tracos

# ── CLAUDE / ANTHROPIC (para resumos executivos com IA) ─────────────────────
# Obtenha em: https://console.anthropic.ai/
ANTHROPIC_API_KEY=sua_chave_anthropic

# ── ALERTAS — WHATSAPP (Zapi) ───────────────────────────────────────────────
# Conta Zapi: https://app.z-api.io/
ZAPI_INSTANCE_ID=seu_instance_id_zapi
ZAPI_TOKEN=seu_token_zapi
# ID do grupo de alertas (obtenha via API do Zapi após criar o grupo)
WHATSAPP_GRUPO_ID=id_do_grupo_alertas

# ── ALERTAS — E-MAIL (SendGrid) ─────────────────────────────────────────────
# Conta SendGrid: https://sendgrid.com/
SENDGRID_API_KEY=sua_chave_sendgrid
EMAIL_REMETENTE=alertas@suaagencia.com.br
EMAIL_DESTINO=voce@suaagencia.com.br
